// ── Zone ──────────────────────────────────────────────────────────────
// Seed-only. Adding a new zone later requires a migration (ALTER TYPE ADD VALUE).

enum Zone {
  WISC
  SISC
  NISC
}

// ── UserType ──────────────────────────────────────────────────────────
// Used only for notification targeting. No permission implications —
// permissions are assigned individually via UserPermission, never bundled
// by role.

enum UserType {
  MANAGER
  SUPERVISOR
  ENGINEER
  TECHNICIAN
  HELPER
}

// ── Department ────────────────────────────────────────────────────────

enum Department {
  QUALITY
  OPERATIONS
  ADMIN
  SALES
  IT
  TESTING
  FINANCE
}

// ── OrderType ─────────────────────────────────────────────────────────

enum OrderType {
  REPAIR_ISR
  REPAIR_SSR
  MANUFACTURING
}

// ── OrderStage ────────────────────────────────────────────────────────
// Calculated internally — see OrderService. ARCHIVED is the soft-delete
// mechanism; there is no CANCELLED value and no separate deletedAt.

enum OrderStage {
  RECEIVED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum SpindleType {
  BELT_DRIVEN
  DIRECT_DRIVEN
  GEAR_DRIVEN
  INTEGRATED
}
