model ElectricalTestMeasurement {
  id           String  @id @default(cuid())
  orderId      String
  testKey      String
  specValue    String? // only used for the 3 rows with a spec dropdown (motor type, thermistor, power unit)
  beforeRework String?
  afterRework  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, testKey])
  @@map("electrical_test_measurements")
}
