model DrawbarDetails {
  id                             String  @id @default(cuid())
  orderId                        String  @unique
  arrangement                    String?
  drawBarArrangementOd           String?
  drawBarArrangementId           String?
  drawBarArrangementThickness    String?
  drawBarArrangementHeight       String?
  drawBarArrangementQuantity     String?
  drawBarArrangementLength       String?
  beforeDismantlingClampingForce String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("drawbar_details")
}
