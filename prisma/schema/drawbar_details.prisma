model DrawbarDetails {
  id                             String  @id @default(cuid())
  orderId                        String  @unique
  drawBarArrangement                String?
  drawBarArrangementOd              String?
  drawBarArrangementId              String?
  drawBarArrangementThickness       String?
  drawBarArrangementHeight          String?
  drawBarArrangementQuantity        String?
  drawBarArrangementLength          String?
  clampingForceBeforeAssembly       String?

  drawBarArrangementAfterAssembly           String?
  drawBarArrangementOdAfterAssembly         String?
  drawBarArrangementIdAfterAssembly         String?
  drawBarArrangementThicknessAfterAssembly  String?
  drawBarArrangementHeightAfterAssembly     String?
  drawBarArrangementQuantityAfterAssembly   String?
  drawBarArrangementLengthAfterAssembly     String?
  clampingForceAfterAssembly                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("drawbar_details")
}
