// ── Spindle ──────────────────────────────────────────────────────────
// The physical unit — permanent identity independent of any single
// order, since the same spindle can return for repair multiple times.
// No soft delete: physical asset records are never removed (matches
// spindles:* permission set, which has no delete/deactivate key).

model Spindle {
  id           String  @id @default(cuid())
  serialNumber String  @unique
  make         String
  type         String
  taperId      String
  maxRpm       String? // kept as String — legacy data isn't strictly numeric

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taper Taper @relation(fields: [taperId], references: [id])

  // NOTE: an `orders Order[]` back-relation belongs here once
  // orders.prisma is written (Sales Entry/Order domain, next after this
  // one). Prisma requires both sides of a relation to exist
  // simultaneously — do not add this field until Order model exists,
  // or schema validation will fail.

  @@map("spindles")
}
