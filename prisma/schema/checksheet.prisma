model Checksheet {
  id               String  @id @default(cuid())
  orderId          String  @unique
  box              String?
  toolHolder       String?
  cylinder         String?
  proxySwitch      String?
  tenon            String?
  pulley           String?
  drawbar          String?
  speedSensor      String?
  spindleCondition String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("checksheet")
}
