// ── MediaType ────────────────────────────────────────────────────────

enum MediaType {
  PHOTO
  VIDEO
  AUDIO
  FILE
}

// ── Media ────────────────────────────────────────────────────────────
// Unified table — no split between internal/customer-facing (all media
// is customer-visible by default, per earlier decision). Scoped to
// (orderId, reportName), matching Notes/Personnel's shape.
//
// Only objectKey is stored, never a public URL — the bucket is private,
// and every read/write goes through a short-lived presigned URL
// generated by the backend at request time. Backend never touches file
// bytes; frontend uploads directly to Spaces and only tells the backend
// "this key now exists, here's its type" after success.
//
// No validation on media_type or file size here — the backend only
// records what the frontend declares (compression/type-checking is
// entirely a frontend concern, per earlier decision).

model Media {
  id         String    @id @default(cuid())
  orderId    String
  reportName String
  objectKey  String
  mediaType  MediaType

  uploadedById String
  createdAt    DateTime @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([orderId, reportName])
  @@map("media")
}
