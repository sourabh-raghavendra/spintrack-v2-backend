model DamageReport {
  id                   String  @id @default(cuid())
  orderId              String  @unique
  bearingDamage        String?
  shaftTaper           String?
  shaftOdDamage        String?
  mechanicalSeal       String?
  pulleyDamage         String?
  encoderDamage        String?
  rotaryUnion          String?
  spacerDistanceSleeve String?
  tenonDamage          String?
  oRings               String?
  drawbarColletes      String?
  springDamage         String?
  sensorsDamage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("damage_report")
}
