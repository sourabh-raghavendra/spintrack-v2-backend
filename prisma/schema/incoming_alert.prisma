model IncomingAlert {
  id                             String   @id @default(cuid())
  orderId                        String   @unique
  spindleIssue                   String?
  firstTimeCustomer              Boolean?
  customerPaymentPending         Boolean?
  dispatchWithoutClearance       Boolean?
  dispatchWithoutClearanceReason String?
  salesApproval                  Boolean?
  financeApproval                Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@map("incoming_alert")
}
