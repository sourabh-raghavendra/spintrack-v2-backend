// ── Order ────────────────────────────────────────────────────────────
// The "Job Order" header. orderStage is calculated internally by the
// system (see OrderService state machine notes) — never set directly
// via a general update endpoint.
//
// No deletedAt — ARCHIVED *is* the soft-delete mechanism. Hard delete is
// only permitted from ARCHIVED, and is an admin-only action.

model Order {
  id String @id @default(cuid())

  rma       String @unique
  so        String @unique
  jo        String @unique
  quotation String @unique

  orderType  OrderType
  orderStage OrderStage @default(RECEIVED)
  isUnderWarranty Boolean @default(false)

  spindleReceivedDate DateTime?

  zone Zone

  customerId        String
  spindleId         String
  createdById       String
  customerContactId String? // who to notify on order updates (form completion,
  // report generation, etc.) — nullable, since not
  // every order will have a contact explicitly picked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer        Customer         @relation(fields: [customerId], references: [id])
  spindle         Spindle          @relation(fields: [spindleId], references: [id])
  createdBy       User             @relation(fields: [createdById], references: [id])
  customerContact CustomerContact? @relation(fields: [customerContactId], references: [id])
  reportLogs      OrderReportLog[]

  // Report tables — one relation per report/table (bearings and
  // testing_balancing_trials are multi-row per order, no @unique on
  // their side; the rest are 1:1 with the order)
  incomingAlert              IncomingAlert?
  checksheet                 Checksheet?
  damageReport               DamageReport?
  electricalTestMeasurements ElectricalTestMeasurement[]
  drawbarDetails             DrawbarDetails?
  finalInspection            FinalInspection?
  remarksForCustomer         RemarksForCustomer?
  orderClosure               OrderClosure?
  bearings                   Bearing[]
  inspectionMeasurements     InspectionMeasurement[]
  testingBalancing           TestingBalancing?
  testingBalancingTrials     TestingBalancingTrial[]
  deviations                 Deviations?
  reportPersonnel            ReportPersonnel[]
  notes                      Note[]
  media                      Media[]

  @@map("orders")
}
